# ==============================================================================
# Dockerfile.frontend - Vitraglass System Frontend
# React 19 + Vite 6 + Nginx Alpine Multi-stage Build
# Rúbrica UTP: Sección 9.1 (Empaquetado) y Sección 10 (Matriz de Evidencias)
# ==============================================================================

# ------------------------------------------------------------------------------
# Etapa 1: Build & Compilation (Node.js 22 Alpine)
# ------------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

# Instalar compatibilidad libc para herramientas nativas si son requeridas
RUN apk add --no-cache libc6-compat

# Copiar manifiestos de dependencias para maximizar el uso de caché de capas
COPY package.json package-lock.json ./

# Instalación estricta y determinista de dependencias
RUN npm ci --prefer-offline --no-audit

# Copiar el código fuente completo del frontend
COPY . .

# Argumentos de construcción configurables
ARG VITE_API_URL=https://frontendvitraglass.vercel.app/api
ARG VITE_USE_MOCKS=false

# Inyección de variables de entorno para compilación con Vite
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_USE_MOCKS=$VITE_USE_MOCKS
ENV NODE_ENV=production

# Compilación de la aplicación a /app/dist
RUN npm run build

# ------------------------------------------------------------------------------
# Etapa 2: Servidor Web de Producción (Nginx 1.27 Alpine)
# ------------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runner

# Instalar curl para monitoreo y verificación de salud
RUN apk add --no-cache curl

# Eliminar la configuración default de Nginx
RUN rm -rf /etc/nginx/conf.d/*

# Copiar configuración hardened optimizada para React SPA
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copiar artefactos estáticos generados en la etapa de construcción
COPY --from=builder /app/dist /usr/share/nginx/html

# Ajustar permisos defensivos para el usuario del servidor web
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Puerto HTTP estándar
EXPOSE 80

# Healthcheck nativo para Docker Engine, Compose y Kubernetes
HEALTHCHECK --interval=30s --timeout=3s --retries=3 --start-period=5s \
  CMD curl -f http://localhost:80/healthz || exit 1

STOPSIGNAL SIGQUIT

CMD ["nginx", "-g", "daemon off;"]
